{
  "name": "gitlab-ci",
  "version": "1.0.0",
  "author": "ProGit Team",
  "description": "Queries GitLab CI/CD pipeline status for merge requests",
  "license": "Apache-2.0",
  "runtime": "lua",
  "entry_point": "main.lua",
  "config_schema": {
    "gitlab_api_url": {
      "type": "string",
      "description": "GitLab API base URL (e.g., https://gitlab.com/api/v4)",
      "required": true
    },
    "gitlab_token": {
      "type": "string",
      "description": "GitLab Personal Access Token with read_api scope",
      "required": true,
      "secret": true
    }
  },
  "events": [
    "PipelineStatusQuery"
  ],
  "tags": [
    "gitlab",
    "ci-cd",
    "pipelines",
    "devops",
    "automation"
  ]
}
